esphome:
  name: m5-env3

esp32:
  board: m5stick-c
  flash_size: 8MB
  framework:
    type: esp-idf

logger:

ota:
  - platform: esphome

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password

mqtt:
  broker: 192.168.100.174
  port: 1883
  discovery: false

# The Plus2 powers itself off on battery unless GPIO4 is held high
switch:
  - platform: gpio
    pin: GPIO4
    id: power_hold
    restore_mode: ALWAYS_ON
    internal: true

i2c:
  sda: GPIO32
  scl: GPIO33
  scan: true
  frequency: 100kHz

sensor:
  - platform: sht3xd
    address: 0x44
    temperature:
      name: "Indoor Temperature"
      id: indoor_temp
    humidity:
      name: "Indoor Humidity"
      id: indoor_hum
    update_interval: 30s

  - platform: qmp6988
    address: 0x70
    temperature:
      name: "QMP Temperature"
      internal: true
    pressure:
      name: "Indoor Pressure"
      id: indoor_pressure
    update_interval: 30s

interval:
  - interval: 30s
    then:
      - mqtt.publish_json:
          topic: weewxrtlsdr/indoor/state
          payload: |-
            root["temperature_C"] = id(indoor_temp).state;
            root["humidity_pct"] = id(indoor_hum).state;
            root["pressure_hPa"] = id(indoor_pressure).state;
