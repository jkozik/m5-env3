esphome:
  name: m5-env3

esp32:
  board: m5stick-c
  flash_size: 8MB
  framework:
    type: esp-idf

logger:

ota:
  - platform: esphome

text_sensor:
  - platform: version
    name: "ESPHome Version"

wifi:
  id: wifi_comp
  ssid: !secret wifi_ssid
  password: !secret wifi_password

mqtt:
  broker: 192.168.100.174
  port: 1883
  discovery: false

web_server:
  port: 80
  version: 3

# The Plus2 powers itself off on battery unless GPIO4 is held high
switch:
  - platform: gpio
    pin: GPIO4
    id: power_hold
    restore_mode: ALWAYS_ON
    internal: true

i2c:
  sda: GPIO32
  scl: GPIO33
  scan: true
  frequency: 100kHz

spi:
  clk_pin: GPIO13
  mosi_pin: GPIO15

output:
  - platform: ledc
    pin: GPIO27
    inverted: false
    id: backlight_output

light:
  - platform: monochromatic
    output: backlight_output
    id: display_backlight
    name: "Display Backlight"
    restore_mode: ALWAYS_ON

font:
  - file: "gfonts://Roboto"
    id: font_main
    size: 18

display:
  - platform: mipi_spi
    model: st7789v
    cs_pin: GPIO5
    dc_pin: GPIO14
    reset_pin: GPIO12
    rotation: 90
    dimensions:
      height: 240
      width: 135
      offset_height: 40
      offset_width: 52
    invert_colors: true
    update_interval: 1s
    lambda: |-
      // Heartbeat: blinking dot, top-right, proves the loop is still running
      if ((millis() / 500) % 2 == 0) {
        it.filled_circle(125, 8, 4, Color(0, 255, 0));
      }

      // WiFi status: green = connected, red = not connected, top-left
      if (id(wifi_comp).is_connected()) {
        it.filled_circle(8, 8, 4, Color(0, 255, 0));
      } else {
        it.filled_circle(8, 8, 4, Color(255, 0, 0));
      }

      // Sensor readout
      it.printf(0, 30, id(font_main), Color(255, 255, 255), "%.1f C", id(indoor_temp).state);
      it.printf(0, 60, id(font_main), Color(255, 255, 255), "%.0f %%RH", id(indoor_hum).state);
      it.printf(0, 90, id(font_main), Color(255, 255, 255), "%.0f hPa", id(indoor_pressure).state);

sensor:
  - platform: sht3xd
    address: 0x44
    temperature:
      name: "Indoor Temperature"
      id: indoor_temp
    humidity:
      name: "Indoor Humidity"
      id: indoor_hum
    update_interval: 30s

  - platform: qmp6988
    address: 0x70
    temperature:
      name: "QMP Temperature"
      internal: true
    pressure:
      name: "Indoor Pressure"
      id: indoor_pressure
    update_interval: 30s

interval:
  - interval: 30s
    then:
      - mqtt.publish_json:
          topic: weewxrtlsdr/indoor/state
          payload: |-
            root["temperature_C"] = id(indoor_temp).state;
            root["humidity_pct"] = id(indoor_hum).state;
            root["pressure_hPa"] = id(indoor_pressure).state;